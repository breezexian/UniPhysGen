# Shared rules for UniPhysGen and UniPhys Pipeline.
# Keep project ignore rules here; child .gitignore files are not needed by Git.

# Operating systems and editors
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
tempCodeRunnerFile.py

# Python bytecode and compiled extensions
__pycache__/
*.py[codz]
*$py.class
*.so
*.pyd
cython_debug/

# Packaging and build artifacts
.Python
build/
dist/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg
wheels/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pixi/
.pdm-python
.pdm-build/
__pypackages__/

# Caches, tests, and notebooks
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
*.cover
*.py.cover
.ipynb_checkpoints/

# Secrets and local configuration; keep the public environment example.
.env
.env.*
!.env.example
.envrc
.pypirc
/configs/local*.yaml
/configs/local*.yml
/configs/local*.json
/uniphysgen/configs/local*.yaml
/uniphysgen/configs/local*.yml
/uniphysgen/configs/local*.json
/uniphys_pipeline/configs/local*.yaml
/uniphys_pipeline/configs/local*.yml
/uniphys_pipeline/configs/local*.json

# Training, inference, and Pipeline runtime outputs
outputs/
exp_results/
logs/
wandb/
runs/
tensorboard/
checkpoint-*/
.pipeline/
tmp_partfield_*/
*.log
events.out.tfevents.*

# Local datasets, downloaded models, and evaluation reports.
# Scope these to project roots: nested data/ directories also contain source code.
/data/
/datasets/
/downloads/
/checkpoints/
/metrics/
/tmp/
/uniphysgen/data/
/uniphysgen/datasets/
/uniphysgen/downloads/
/uniphysgen/checkpoints/
/uniphysgen/metrics/
/uniphysgen/tmp/
/uniphys_pipeline/data/
/uniphys_pipeline/datasets/
/uniphys_pipeline/downloads/
/uniphys_pipeline/checkpoints/
/uniphys_pipeline/metrics/
/uniphys_pipeline/tmp/

# Preprocessed datasets and training outputs used by UniPhysGen configs
/saves/
/saves_*/
/physmeshllm_base-*/
/uniphysgen/saves/
/uniphysgen/saves_*/
/uniphysgen/physmeshllm_base-*/

# Model weights and exported inference engines (including third-party models)
*.ckpt
*.pth
*.pt
*.safetensors
*.onnx
*.engine
pytorch_model*.bin
adapter_model*.bin
training_args.bin

# Preserve the Pipeline's existing binary-intermediate policy without hiding
# small NumPy examples elsewhere. Mesh samples and documentation assets stay addable.
/uniphys_pipeline/**/*.npy
/uniphys_pipeline/**/*.npz
/uniphys_pipeline/**/*.exr
